From: HRAvatar stable_bbox integration
Subject: [PATCH] Accept a precomputed (basename -> similarity tform) sequence
 instead of running per-frame FAN face detection.
Date: 2026

Why
---
HRAvatar's `preprocess/stable_bbox.py` writes a temporally smoothed crop
sequence (`stable_bbox.npz`) derived from MediaPipe's stable landmark subset
plus a zero-phase FIR low-pass on the size series. The DECA preprocessing
step needs to consume the SAME crops so that:

  (a) `code.json` `tform` and `cam[s]` reflect the smoothed (center, size),
      not FAN's per-frame bbox jitter; and
  (b) downstream `optimize.py`, `keypoint_detector.py`, `iris.py` see a
      stable head pose, not one that breathes with the mouth.

Without this patch DECA's `TestData` re-detects the face per frame with
FAN, defeating the upstream stabilization.

Apply with
----------
  cd preprocess/submodules/DECA
  git apply ../../../tools/patches/deca-stable-bbox.patch

Both files use unified-diff format. If the line numbers in your DECA fork
have drifted, use `git apply --reject` and merge the .rej hunks by hand —
the changes are tightly localised (one new arg + one new branch).

Compatibility note
------------------
The patch is purely additive: when `--precomputed-bbox` is not supplied,
or when the npz lacks an entry for the current frame's basename, DECA
falls back to its original FAN-based behaviour. Existing call sites that
don't know about the flag continue to work.

---
 decalib/datasets/datasets.py | 60 ++++++++++++++++++++++++++++++++++++--
 demos/demo_reconstruct.py    |  9 +++++-
 2 files changed, 66 insertions(+), 3 deletions(-)

diff --git a/decalib/datasets/datasets.py b/decalib/datasets/datasets.py
--- a/decalib/datasets/datasets.py
+++ b/decalib/datasets/datasets.py
@@ -1,6 +1,7 @@
 import os, sys
 import torch
 import numpy as np
+import os.path as osp
 from torch.utils.data import Dataset
 from glob import glob
 import cv2
@@ -10,7 +11,7 @@ from skimage.transform import estimate_transform, warp, resize, rescale
 from . import detectors

 class TestData(Dataset):
-    def __init__(self, testpath, iscrop=True, crop_size=224, scale=1.25, face_detector='fan', sample_step=10):
+    def __init__(self, testpath, iscrop=True, crop_size=224, scale=1.25, face_detector='fan', sample_step=10, precomputed_tforms_path=None):
         '''
             testpath: folder, imagepath_list, image path, video path
         '''
@@ -41,6 +42,33 @@ class TestData(Dataset):
             self.face_detector = detectors.MTCNN()
         else:
             print(f'please check the detector: {face_detector}')
+
+        # ---- HRAvatar stable_bbox integration ----
+        # When supplied, `precomputed_tforms_path` points at an `.npz` written by
+        # `preprocess/stable_bbox.py`. It carries one similarity-transform per
+        # frame (basename -> 3x3 matrix) computed from a stable landmark subset
+        # plus a zero-phase FIR LPF on the size series. We use those tforms
+        # *instead* of running FAN per frame, which removes the mouth/blink
+        # jitter that otherwise leaks into bbox `size` -> `cam[s]` -> rendered
+        # mesh wobble. Falls back to FAN per-frame for any frame whose basename
+        # is missing from the npz, so partial coverage is safe.
+        self._precomputed_tforms = None
+        if precomputed_tforms_path is not None and osp.isfile(precomputed_tforms_path):
+            npz = np.load(precomputed_tforms_path, allow_pickle=False)
+            names = [str(b) for b in npz['frame_basenames']]
+            tforms = npz['tform']  # (N, 3, 3) float64
+            # Also stash the (center, size) so we can rebuild src_pts in the
+            # exact crop_face convention; we don't strictly need it because
+            # `tform.params` already encodes the same affine, but keeping the
+            # native fields makes future debugging easier.
+            self._precomputed_tforms = {
+                name: tforms[i] for i, name in enumerate(names)
+            }
+            self._precomputed_path = precomputed_tforms_path
+            print(f'[deca/TestData] using precomputed stable bbox '
+                  f'({len(self._precomputed_tforms)} frames) from '
+                  f'{precomputed_tforms_path}')
+
         self.crop_size = crop_size
         self.scale = scale
         self.iscrop = iscrop
@@ -60,7 +88,33 @@ class TestData(Dataset):
         h, w, _ = image.shape
         if self.iscrop:
             # provide kpt as txt file, or mat file (for AFLW2000)
-            kpt_matpath = os.path.splitext(imagepath)[0]+'.mat'
+            # ---- HRAvatar stable_bbox short-circuit ----
+            # If a precomputed tform exists for this frame, skip FAN entirely
+            # and reuse the smoothed similarity transform. The downstream
+            # `code.json` `tform` field then reflects the stabilised crop, so
+            # `optimize.py` / HRAvatar training all see consistent (center,
+            # size) values across frames.
+            basename = osp.basename(imagepath)
+            if (self._precomputed_tforms is not None
+                    and basename in self._precomputed_tforms):
+                tform_params = self._precomputed_tforms[basename]
+                # Reconstruct an `skimage.SimilarityTransform`-shaped object
+                # whose `.params` and `.inverse` match what the original code
+                # path produces, so the rest of `__getitem__` is identical.
+                tform = estimate_transform('similarity',
+                                           np.eye(3)[:2, :2],
+                                           np.eye(3)[:2, :2])
+                tform.params[:] = tform_params
+                # Same warp + tensor packaging the FAN path uses below; we
+                # short-circuit *only* the bbox-derivation step, not the
+                # downstream image / tform serialisation.
+                dst_image = warp(image, tform.inverse, output_shape=(self.crop_size, self.crop_size))
+                dst_image = dst_image.transpose(2, 0, 1)
+                return {'image': torch.tensor(dst_image).float(),
+                        'imagename': osp.splitext(basename)[0],
+                        'tform': torch.tensor(tform.params).float(),
+                        'original_image': torch.tensor(image.transpose(2, 0, 1)).float()}
+            kpt_matpath = osp.splitext(imagepath)[0]+'.mat'
             kpt_txtpath = os.path.splitext(imagepath)[0]+'.txt'
             if os.path.exists(kpt_matpath):
                 kpt = scipy.io.loadmat(kpt_matpath)['pt3d_68'].T
diff --git a/demos/demo_reconstruct.py b/demos/demo_reconstruct.py
--- a/demos/demo_reconstruct.py
+++ b/demos/demo_reconstruct.py
@@ -38,7 +38,12 @@ def main(args):
     savefolder = args.savefolder
     device = args.device
     os.makedirs(savefolder, exist_ok=True)

     # load test images
-    testdata = datasets.TestData(args.inputpath, iscrop=args.iscrop, face_detector=args.detector, sample_step=args.sample_step)
+    testdata = datasets.TestData(
+        args.inputpath,
+        iscrop=args.iscrop,
+        face_detector=args.detector,
+        sample_step=args.sample_step,
+        precomputed_tforms_path=args.precomputed_bbox,
+    )

     # run DECA
@@ -100,6 +105,8 @@ if __name__ == '__main__':
                         help='whether to use FLAME texture model to generate uv texture map, \
                             set it to True only if you downloaded texture model' )
+    parser.add_argument('--precomputed-bbox', type=str, default=None,
+                        help='Path to HRAvatar `stable_bbox.npz`. When supplied, the smoothed similarity transform per frame replaces FAN per-frame face detection so DECA crops match the stabilized bbox sequence consumed by `scene/data_loader.py` at training time.')
     main(parser.parse_args())
